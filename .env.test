NODE_ENV=test
PORT=3001
LOG_LEVEL=silent
DATABASE_URL=postgres://pulsecheck:pulsecheck@localhost:5432/pulsecheck_test
REDIS_URL=redis://localhost:6379
BCRYPT_ROUNDS=4
SESSION_TTL_HOURS=168
AUTH_LOGIN_MAX_FAILURES=1000
AUTH_LOGIN_WINDOW_MINUTES=15
REGISTER_MAX_PER_WINDOW=1000
REGISTER_WINDOW_MINUTES=60
MAX_MONITORS_PER_USER=3
WORKER_CONCURRENCY=2
QUEUE_PREFIX=pulsecheck-test
WORKER_SHUTDOWN_TIMEOUT_MS=10000
CHECK_JOB_ATTEMPTS=1
CHECK_JOB_BACKOFF_MS=50
