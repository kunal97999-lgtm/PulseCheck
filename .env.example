NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgres://pulsecheck:pulsecheck@localhost:5432/pulsecheck
REDIS_URL=redis://localhost:6379

WORKER_CONCURRENCY=5
QUEUE_PREFIX=pulsecheck
WORKER_SHUTDOWN_TIMEOUT_MS=40000
SCHEDULER_TICK_MS=5000
SCHEDULER_BATCH_SIZE=100
CHECK_JOB_ATTEMPTS=3
CHECK_JOB_BACKOFF_MS=2000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
MAIL_FROM=PulseCheck <alerts@pulsecheck.local>
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_BACKOFF_MS=5000
NOTIFICATION_LEASE_SECONDS=60
NOTIFICATION_SWEEP_MS=30000
NOTIFICATION_STALE_SECONDS=120
CHECK_RETENTION_DAYS=35
INCIDENT_RETENTION_DAYS=90
RETENTION_INTERVAL_MS=3600000
RETENTION_BATCH_SIZE=5000
RETENTION_MAX_BATCHES=200
USER_API_MAX_PER_MINUTE=300
USER_WRITE_MAX_PER_MINUTE=30
# OPS_TOKEN=generate-with-the-command-below
OPS_OVERDUE_SECONDS=300
OPS_NOTIFICATION_LAG_SECONDS=900
OPS_HEARTBEAT_MS=10000
OPS_WORKER_STALE_SECONDS=30